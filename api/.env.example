# Copy to api/.env and fill in. Every value is required unless noted.

# Local Postgres, from docker-compose.yml at the repository root.
DATABASE_URL=postgresql://how:how_local_dev@127.0.0.1:5440/holidaysonwheels

# Must be byte-identical to the Next.js app's AUTH_SECRET.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=

# Optional — defaults shown.
PORT=4000
CORS_ORIGINS=http://localhost:3000
MEDIA_ROOT=../public/media
LOG_LEVEL=info
