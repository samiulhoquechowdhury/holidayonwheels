{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-verify/types/**/*.ts"
  ],
  // `**/*.ts` sweeps the whole tree, so any alternate dist dir created with
  // NEXT_DIST_DIR — `.next-verify`, `.next-admin` — gets typechecked too, and
  // its generated route types go stale the moment a file moves. Next also
  // appends each such directory to `include` on its own when it builds. Both
  // are excluded here; the real build's types under `.next/types` are the
  // ones that matter and stay.
  // `api/` is a separate package with its own tsconfig, its own
  // `node_modules` and its own `@types`. Swept in by `**/*.ts` above, its
  // files get typechecked with *this* configuration and fail on type
  // packages that only exist in its own tree (`pino-http`, `@types/express`).
  //
  // Excluding it does not stop `src/lib/db.ts` importing the Drizzle schema
  // from it: TypeScript follows imports regardless of `exclude`, so those
  // specific files are still checked — as part of the import graph, where
  // they only need `drizzle-orm`, which this package also has.
  "exclude": ["node_modules", ".next-*", "api"]
}
